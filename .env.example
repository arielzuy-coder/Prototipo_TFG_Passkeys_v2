# ---------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://authuser:authpass@localhost:5432/auth_passkeys

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar
JWT_SECRET=cambiar
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# WebAuthn: RP_ID es el dominio del FRONTEND (donde corre el navegador), sin esquema ni puerto.
# ORIGIN es el origen exacto del frontend. Si no coinciden, el navegador o el backend rechazan la passkey.
RP_ID=localhost
RP_NAME=Prototipo Autenticacion TFG
ORIGIN=http://localhost:3000
MAX_PASSKEYS_PER_USER=5

# Orígenes CORS adicionales (separados por coma). ORIGIN ya está incluido.
CORS_ORIGINS=

# Alta del primer administrador: si no hay ninguno, init_db.py escribe en el log
# un link de invitación de un solo uso para este email.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
INVITATION_TTL_HOURS=72
# Base para armar los links de invitación (por defecto, ORIGIN)
FRONTEND_URL=

# Step-up
STEPUP_TTL_MINUTES=10
STEPUP_MAX_ATTEMPTS=5

# OTP por email (opcional). Si SMTP_HOST queda vacío, el OTP no se ofrece.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Motor de riesgo
RISK_THRESHOLD_LOW=40
RISK_THRESHOLD_HIGH=75

# ---------------------------------------------------------------
# Frontend (React)
# ---------------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000
