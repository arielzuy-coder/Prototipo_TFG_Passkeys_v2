# ---------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://authuser:authpass@localhost:5432/auth_passkeys

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar
JWT_SECRET=cambiar
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# WebAuthn: RP_ID es el dominio del FRONTEND (donde corre el navegador), sin esquema ni puerto.
# ORIGIN es el origen exacto del frontend. Si no coinciden, el navegador o el backend rechazan la passkey.
RP_ID=localhost
RP_NAME=Prototipo Autenticacion TFG
ORIGIN=http://localhost:3000
MAX_PASSKEYS_PER_USER=5

# Orígenes CORS adicionales (separados por coma). ORIGIN ya está incluido.
CORS_ORIGINS=

# Alta del primer administrador: si no hay ninguno, init_db.py escribe en el log
# un link de invitación de un solo uso para este email.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
INVITATION_TTL_HOURS=72
# Base para armar los links de invitación (por defecto, ORIGIN)
FRONTEND_URL=

# Step-up
STEPUP_TTL_MINUTES=10
STEPUP_MAX_ATTEMPTS=5

# OTP por email (opcional). Si SMTP_HOST queda vacío, el OTP no se ofrece.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Motor de riesgo
RISK_THRESHOLD_LOW=40
RISK_THRESHOLD_HIGH=75
# Países de bajo riesgo (códigos ISO separados por coma)
TRUSTED_COUNTRIES=AR
# Horario laboral (hora de Buenos Aires); fuera de él el factor horario suma 40 puntos
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=19:00
BUSINESS_WEEKDAYS_ONLY=true

# IP real del cliente detrás de un proxy (ver docs/CAMBIOS_V2.md, "IP del cliente").
# 0 = IP de la conexión (sin proxy). En Render, calibrar con GET /admin/diagnostics/client-ip.
TRUSTED_PROXY_HOPS=0
# Alternativa: header que el proxy siempre sobrescribe con la IP real (ej. true-client-ip)
CLIENT_IP_HEADER=

# Geolocalización: local (base incluida, la IP no sale del servidor), ipapi o none
GEOIP_PROVIDER=local
GEOIP_CACHE_SECONDS=3600
# País para IPs privadas/loopback. Solo para desarrollo local (ej. AR); vacío en producción
LOCAL_IP_COUNTRY=

# Límite de intentos (por IP y por cuenta)
RATE_LIMIT_ENABLED=true

# Re-autenticación exigida a operaciones sensibles del administrador
REAUTH_MAX_AGE_MINUTES=10

# Verificación continua: reevaluación de la sesión según su nivel de riesgo (minutos)
SESSION_REEVAL_MINUTES_LOW=30
SESSION_REEVAL_MINUTES_MEDIUM=15
SESSION_REEVAL_MINUTES_HIGH=5

# ---------------------------------------------------------------
# Frontend (React)
# ---------------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000
